#!/bin/sh
# Lock the session.
#
# Prefers the Quickshell lockscreen, and falls back to swaylock when the shell
# is not running — a lock command that silently does nothing is a worse failure
# than an ugly lock screen, so the fallback is not optional.

if qs -c hyprland ipc call lock lock >/dev/null 2>&1; then
    exit 0
fi

wall=$(cat "$HOME/.cache/wal/wal" 2>/dev/null)
if [ -n "$wall" ] && [ -f "$wall" ]; then
    exec swaylock -i "$wall"
fi
exec swaylock
