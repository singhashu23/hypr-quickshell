#!/bin/sh
# Session-start wallpaper: bring up the awww daemon, then apply a random one.

awww kill >/dev/null 2>&1
awww-daemon >/dev/null 2>&1 &

# wait for the daemon's socket rather than racing it
i=0
while [ $i -lt 50 ]; do
    awww query >/dev/null 2>&1 && break
    i=$((i + 1))
    sleep 0.1
done

exec randWall
